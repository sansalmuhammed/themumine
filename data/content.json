  "about": {
    "hero": {
      "nameLine1": "MUMINE SERAP",
      "nameLine2": "KIZILIRMAK",
      "paragraphs": [
        "I am a 21st-century explorer and maker of meanings — working across animation, game narrative, theatre, and visual storytelling.",
        "My practice moves between writing, concept development, and project leadership; I build worlds where emotion lives in timing and the smallest gesture.",
        "From TEKNOFEST stages to Vancouver film kitchens, I gather influences and return them as stories that ask who gets to tell the tale."
      ],
      "image": {
        "src": "assets/about-hero-portrait.jpg",
        "alt": "Mümine Serap portrait"
      }
    },
    "story": {
      "image": {
        "src": "assets/about-story-portrait.jpg",
        "alt": "Mümine Serap"
      },
      "blocks": [
        {
          "num": "01",
          "label": "ORIGINS",
          "quote": "Emotion lives in timing and the smallest gesture.",
          "text": "Educated across engineering and the arts, I found my voice in competition halls and on stage — including TEKNOFEST, where discipline met imagination and narrative became a craft worth testing in public."
        },
        {
          "num": "02",
          "label": "EXPANSION",
          "quote": "Vancouver was an international kitchen; everyone brought their own flavors.",
          "text": "At Vancouver Film School I learned that collaboration is seasoning: each voice changes the recipe. I carried that openness into animation pipelines, writers' rooms, and cross-cultural projects."
        },
        {
          "num": "03",
          "label": "PHILOSOPHY",
          "quote": "Until lions have their own historians, tales of hunting will always glorify the hunter.",
          "text": "Theatre criticism taught me to read power in every frame. I aim to make work that widens who is seen and heard — stories that do not only glorify the hunt."
        }
      ]
    },
